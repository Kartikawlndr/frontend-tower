# Copy this file to .env and replace every placeholder before starting Directus.
# Never commit .env or share its contents.

DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=replace-with-a-strong-database-password

KEY=replace-with-a-long-random-key
SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
PUBLIC_URL=https://your-directus-domain.example

# Allow the signup app to establish the browser's Directus login session.
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Public registration and email verification must also be enabled in Directus settings.
# Select the least-privilege Applicant role there.
USER_REGISTER=true
USER_REGISTER_ROLE=replace-with-applicant-role-uuid
USER_REGISTER_URL_ALLOW_LIST=http://localhost:3000/api/verify-email
PORTAL_URL=http://localhost:3000
USER_INVITE_URL_ALLOW_LIST=http://localhost:3000/set-password
PASSWORD_RESET_URL_ALLOW_LIST=http://localhost:3000/set-password

# SMTP used by Directus Flows to email tower registration receipts.
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-sender-address@example.com
EMAIL_SMTP_PASSWORD=replace-with-a-new-smtp-app-password
EMAIL_FROM=your-sender-address@example.com
